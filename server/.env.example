PORT=3000
CLIENT_URL=http://localhost:4200

# Required: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace-with-at-least-32-random-bytes-hex
JWT_EXPIRES_IN=12h

# Optional for local dev (falls back to file:slido.db if blank)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
